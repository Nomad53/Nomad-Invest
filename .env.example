# Store secrets in Vercel environment variables, never in a public source file.
# Node does not automatically read this file. See README for local usage.
NOMAD_PASSWORD=

# Only enable once the source's use and redistribution rights are established.
MARKET_DATA_AUTHORIZED=false
# A server-controlled HTTPS endpoint implementing DATA_CONTRACT.md.
# This is NOT an arbitrary PSX public webpage or an assumed vendor API.
MARKET_DATA_URL=
MARKET_DATA_TOKEN=

# Future NOMAD-trained model output, separate from market prices.
SIGNAL_DATA_URL=
SIGNAL_DATA_TOKEN=
# Keep empty until actual validation, costs and forward tests are reviewed.
APPROVED_MODEL_IDS=

# Reviewed JSON, not sample production financial advice.
# Every fee field is required. Missing fees are never assumed zero.
FEE_MODEL_JSON=
# Named risk policies. These contain LIMITS, not preset target allocations.
RISK_POLICIES_JSON=
